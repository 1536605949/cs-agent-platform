# Secrets & local configuration
# Anything ending in .example is a committed template, never a real secret.
.env
.env.*
!*.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# Runtime data (SQLite database, logs, backups)
data/*.db
data/*.db-shm
data/*.db-wal
data/*.db-journal
data/*.sqlite3
data/*.sqlite3-shm
data/*.sqlite3-wal
*.log
logs/
backups/

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
