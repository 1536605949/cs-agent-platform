# ===========================================================================
# Production environment template
#
#   cp deploy/.env.production.example .env
#
# Then replace every value marked CHANGE_ME. The application refuses to start
# when ENVIRONMENT=production and any placeholder secret is still in place.
# ===========================================================================

ENVIRONMENT=production
LOG_LEVEL=INFO
APP_PORT=8000

# --- storage ---------------------------------------------------------------
# Option A: PostgreSQL (recommended for production)
#   docker compose --profile postgres up -d --build
DATABASE_URL=postgresql+psycopg://cs_user:CHANGE_ME@postgres:5432/cs_platform
POSTGRES_DB=cs_platform
POSTGRES_USER=cs_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5432

# Option B: SQLite (single node, simplest)
# DATABASE_URL=sqlite:///./data/app.db

# --- conversation engine ---------------------------------------------------
ENGINE_MODE=builtin
AUTO_SEED=false

# --- optional LLM ----------------------------------------------------------
LLM_ENABLED=false
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=CHANGE_ME
LLM_MODEL=gpt-4o-mini

# --- optional Dify orchestration (only when ENGINE_MODE=dify) --------------
DIFY_BASE_URL=https://api.dify.ai/v1
DIFY_API_KEY=CHANGE_ME

# --- authentication (mandatory in production) ------------------------------
AUTH_MODE=jwt
JWT_SECRET=CHANGE_ME_use_openssl_rand_hex_32
JWT_ISSUER=cs-agent-platform
JWT_EXPIRE_MINUTES=720
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME

# --- behaviour tuning ------------------------------------------------------
HANDOFF_CONFIDENCE_THRESHOLD=0.35
HANDOFF_MAX_FALLBACK_TURNS=2
FAQ_TOP_K=3
FAQ_MIN_SCORE=1.2
RATE_LIMIT_PER_MINUTE=60
CORS_ORIGINS=https://support.example.com
