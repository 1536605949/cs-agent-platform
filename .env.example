# ===========================================================================
# AI Customer Service Platform - environment template
# Copy to `.env` and adjust. Every value below has a safe development default,
# so the application starts with an empty .env as well.
# ===========================================================================

# --- Application -----------------------------------------------------------
ENVIRONMENT=development          # development | production
LOG_LEVEL=INFO
APP_PORT=8000

# --- Storage ---------------------------------------------------------------
# SQLite works out of the box. Switch to PostgreSQL for production, e.g.
# DATABASE_URL=postgresql+psycopg://cs_user:cs_pass@postgres:5432/cs_platform
DATABASE_URL=sqlite:///./data/app.db

# --- Conversation engine ---------------------------------------------------
# builtin = self-contained engine shipped with this repo (default, zero deps)
# dify    = delegate orchestration to an external Dify application
ENGINE_MODE=builtin

# --- Optional LLM (OpenAI-compatible endpoint) -----------------------------
# Leave LLM_ENABLED=false to run fully offline: the engine then answers from
# the FAQ knowledge base and business tools only.
LLM_ENABLED=false
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30

# --- Optional Dify orchestration (only used when ENGINE_MODE=dify) ---------
DIFY_BASE_URL=https://api.dify.ai/v1
DIFY_API_KEY=
DIFY_TIMEOUT_SECONDS=60

# --- Authentication --------------------------------------------------------
# dev = trust X-User-Id header (local only) | jwt = require Bearer token
AUTH_MODE=dev
JWT_SECRET=dev-only-change-me
JWT_ISSUER=cs-agent-platform
JWT_EXPIRE_MINUTES=720

# Administrator account for the back office (change in production!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# --- Behaviour tuning ------------------------------------------------------
# Below this confidence the engine escalates to a human agent.
HANDOFF_CONFIDENCE_THRESHOLD=0.35
# After this many consecutive unresolved turns the engine hands off automatically.
HANDOFF_MAX_FALLBACK_TURNS=2
# Number of FAQ passages injected as grounding context.
FAQ_TOP_K=3
# Minimum retrieval score for an FAQ hit to be considered an answer.
FAQ_MIN_SCORE=1.2
# Per-user requests per minute.
RATE_LIMIT_PER_MINUTE=60
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
